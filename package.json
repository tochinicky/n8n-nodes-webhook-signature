{
    "name": "n8n-nodes-webhook-signature",
    "version": "0.0.0",
    "description": "n8n community node that verifies Stripe, GitHub, Slack and generic HMAC webhook signatures",
    "license": "MIT",
    "homepage": "https://github.com/tochinicky/n8n-nodes-webhook-signature#readme",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "webhook",
        "hmac",
        "signature",
        "stripe",
        "github",
        "slack"
    ],
    "author": {
        "name": "Onyeamah Tochukwu",
        "email": "tochinicky@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tochinicky/n8n-nodes-webhook-signature.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease",
        "test": "vitest run"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/WebhookSigningSecretApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/VerifyWebhookSignature/VerifyWebhookSignature.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2",
        "vitest": "^3.2.7"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
